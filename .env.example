# Copy to .env and fill in. NEVER commit .env
BRAIN_URL=http://192.168.1.10:8000      # IP of the laptop running the brain
BRAIN_IP=192.168.1.10                   # same IP, used by the PC agent's firewall allow-list
CLINIC_DOMAIN=gmail.com                 # forwards to other domains count as "outside"
CLINIC_EMAIL=sunrise.clinic.demo@gmail.com
POLL_SECONDS=30                         # use 10 during the demo
TELEGRAM_TOKEN=
OWNER_CHAT_ID=                          # owner can approve everything
STAFF_CHAT_IDS=                         # comma separated
VENDOR_CHAT_IDS=                        # vendor_name:chat_id,vendor_name:chat_id
SECURITY_CODE=MANGO-42
CHAT_LANGS=                             # chat_id:kn,chat_id:hi  (default English)
HMAC_SECRET=change-me-to-a-long-random-string
LLM_BASE_URL=                           # any OpenAI-compatible endpoint; empty = templates only
LLM_API_KEY=
LLM_MODEL=
HONEY_TOKENS=decoy-doc:CHANGE-ME-1,decoy-email:CHANGE-ME-2   # link = BRAIN_URL/t/<token>
DEVICE_ID=frontdesk-pc
WATCH_DIR=/home/priya/ClinicFiles
DRY_RUN=1                               # 1 = print firewall commands instead of running them
