# Copy to .env and fill in. NEVER commit .env
BRAIN_URL=http://192.168.1.10:8000      # the brain laptop's IP (ipconfig); redo when the Wi-Fi changes
BRAIN_IP=192.168.1.10
CLINIC_DOMAIN=gmail.com                 # forwards to other domains count as "outside"
CLINIC_EMAIL=clinic.demo@gmail.com      # the demo clinic's Gmail address
POLL_SECONDS=30                         # use 10 during the demo
TELEGRAM_TOKEN=                         # from @BotFather; NEVER put a real token in this file
OWNER_CHAT_ID=                          # owner can approve everything
STAFF_CHAT_IDS=                         # comma separated
VENDOR_CHAT_IDS=                        # vendor_name:chat_id,vendor_name:chat_id
IT_CHAT_ID=                             # optional: IT helper's chat id (gets technical details)
CLINIC_NAME=Sunrise Clinic
OWNER_NAME=                             # e.g. Dr. Rao; shown to the IT helper only
OWNER_PHONE=                            # owner's phone, so the IT helper can call; IT helper only
CLINIC_PHONE=                           # front-desk phone; IT helper only
IT_PHONE=                               # IT helper's phone; staff get it when they ask "call IT helper"
IT_NAME=                                # names shown next to the numbers (all optional)
STAFF_NAME=
VENDOR_NAME=
VENDOR_PHONE=                           # vendor's saved phone
SECURITY_CODE=CHANGE-ME                 # team code; pick your own, never the default
CHAT_LANGS=                             # chat_id:kn,chat_id:hi  (default English)
HMAC_SECRET=change-me-to-a-long-random-string   # same on brain + bot laptops; no "#" in it
LLM_BASE_URL=                           # any OpenAI-compatible endpoint; empty = templates only
LLM_API_KEY=
LLM_MODEL=
HONEY_TOKENS=decoy-doc:CHANGE-ME-1,decoy-email:CHANGE-ME-2   # link = BRAIN_URL/t/<token>
DEVICE_ID=frontdesk-pc
WATCH_DIR=/home/priya/ClinicFiles
DRY_RUN=1                               # 1 = print firewall commands instead of running them
AGENT_TOKEN=                            # long random string, SAME on brain + agent laptops; empty = not checked
BRAIN_TOKEN=                            # long random string for brain + sensors + bot (one laptop); empty = not checked
VENDOR_DOMAINS=                         # your vendors' email domains, comma separated: a rule on their mail scores +2
SUSPEND=1                               # agent: freeze the process doing the writing after containment
SIGNAL_METER=1                          # agent: show the live 3-dot signal line
RANSOM_NOTES=0                          # agent: 1 = a ransom-note file name is a 4th sign (keep 0 until after Gate 2)
PC_HEALTH=0                             # agent (Windows): 1 = report virus protection + update age (keep 0 until after Gate 2)
